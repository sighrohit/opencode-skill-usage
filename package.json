{
  "name": "opencode-skill-usage",
  "version": "0.1.1",
  "description": "OpenCode plugin that tracks per-skill token usage and renders it as a descending chart",
  "keywords": ["opencode", "opencode-plugin", "skills", "token-usage"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sighrohit/opencode-skill-usage.git"
  },
  "bugs": {
    "url": "https://github.com/sighrohit/opencode-skill-usage/issues"
  },
  "homepage": "https://github.com/sighrohit/opencode-skill-usage#readme",
  "type": "module",
  "files": ["src", "!src/**/*.test.ts", "tsconfig.json"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.22",
    "zod": "4.1.8"
  },
  "overrides": {
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode/theme": "^2.0.22",
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8"
  }
}
